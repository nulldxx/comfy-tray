<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NETSDK1233</NoWarn>
    <!-- Required by the [LibraryImport] source generator in JobObject and GuardClient (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);ComfyTray.Tests\**;ComfyTrayGuard\**;ComfyTrayGuard.Installer\**;ComfyTray.Bundle\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icons\app.ico" />
    <Resource Include="icons\red.ico" />
    <Resource Include="icons\green.ico" />
    <None Include="icons\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
