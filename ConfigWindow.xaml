<Window x:Class="ComfyTray.ConfigWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComfyUI Tray Configuration"
        Height="300" Width="660"
        MinHeight="260" MinWidth="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Commands run in a hidden window when ComfyUI starts and stops. Give the program (in quotes if its path contains spaces) followed by any arguments. %VAR% environment tokens are expanded."/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                   Text="Before Start command:"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="BeforeStartBox"
                 Grid.Row="2" Grid.Column="0"
                 Padding="4,3"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="1"
                Content="Browse..."
                Width="86" Margin="8,0,0,0" Padding="0,3"
                Click="BrowseBeforeStart_Click"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="After Stop command:"
                   Margin="0,16,0,4"/>
        <TextBox x:Name="AfterStopBox"
                 Grid.Row="4" Grid.Column="0"
                 Padding="4,3"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Row="4" Grid.Column="1"
                Content="Browse..."
                Width="86" Margin="8,0,0,0" Padding="0,3"
                Click="BrowseAfterStop_Click"/>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5" Grid.ColumnSpan="2"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Save" Width="86" Margin="0,0,8,0" Padding="0,3"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="86" Padding="0,3"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
